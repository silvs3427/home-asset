# Dependencies
node_modules/
.npm/

# Env / secrets — never commit real credentials
.env
.env.*
!.env.example

# Build / cache
dist/
build/
.expo/
.expo-shared/
web-build/
*.tsbuildinfo
coverage/
.turbo/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Native / Expo
ios/Pods/
android/.gradle/
*.jks
*.p8
*.p12
*.mobileprovision

# Firebase FCM private keys (never commit). google-services.json is handled
# under apps/mobile/.gitignore — use EAS file env or force-add if you prefer.
*firebase-adminsdk*.json
fcm-service-account*.json

# Local tooling
.cache/
tmp/

# Local SQLite data (accounts + homes)
apps/api/data/
*.sqlite
*.sqlite-journal

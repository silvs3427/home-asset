{
  "expo": {
    "name": "HomeAsset",
    "slug": "home-asset",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "homeasset",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homeasset.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.homeasset.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#002D72",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-dev-client",
      "expo-updates",
      [
        "expo-image-picker",
        {
          "photosPermission": "HomeAsset needs photo access to attach manuals, receipts, and warranty paperwork.",
          "cameraPermission": "HomeAsset needs the camera so you can photograph warranties and install paperwork on site."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#002D72",
          "defaultChannel": "homeasset-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "52625e1e-c286-4a92-b7d6-39d6bbe009e9"
      }
    }
  }
}

# Copy to .env for local development. Never commit real secrets.
PORT=8787
NODE_ENV=development

# Long random string. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-for-local-dev-only

# Comma-separated origins allowed to call the API (mobile / Expo).
# Leave empty in development to allow Expo LAN / localhost.
CORS_ORIGINS=

# Access token lifetime in seconds (default 1 hour). Keep short.
JWT_TTL_SECONDS=3600

# SQLite file for accounts + homes + document metadata (created automatically).
# Use :memory: only for automated tests. Default path until DATA_BACKEND=supabase.
DATABASE_PATH=./data/homeasset.sqlite

# Durable file store for uploaded manuals / photos (alongside the DB).
STORAGE_PATH=./data/files

# Optional max upload size in bytes (default 15 MiB).
# MAX_UPLOAD_BYTES=15728640

# Shared secret for POST /jobs/due-reminders and /jobs/recalls (cron).
# Required in production. Leave empty in local development to allow open job runs.
# JOBS_SECRET=

# Recall catalog source: fixture (default, CI-safe) or live SaferProducts.gov
# (falls back to fixtures if the feed fails or times out).
# RECALL_SOURCE=fixture
# RECALL_LIVE_TIMEOUT_MS=8000

# Optional Expo access token for live push delivery.
# Without it, pushes are stubbed (logged) and the in-app center still works.
# EXPO_ACCESS_TOKEN=

# Optional OpenAI-compatible key for live AI on the LOCAL Node API only
# (laptop SQLite demo / CI). Phone preview installs do NOT use these —
# they use Supabase Edge Function secrets (GEMINI_API_KEY preferred,
# same as LightLift). See ../../supabase/functions/ai-assist/README.md
# Without a key, a local catalog mock is used so CI needs no secrets.
# AI_API_KEY=
# OPENAI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# Force mock even if a key is present:
# AI_FORCE_MOCK=1

# ---------------------------------------------------------------------------
# Supabase (optional — leave empty for local SQLite demo / CI)
# ---------------------------------------------------------------------------
# Dashboard → Project Settings → API
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
# Server only — never ship to the phone app:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
#
# AUTH_BACKEND=auto          # auto | local | supabase  (auto = Supabase when URL+anon set)
# DATA_BACKEND=sqlite        # sqlite (CI default) | supabase (needs service role + schema)
# STORAGE_BACKEND=auto       # auto | local | supabase
#
# Apply SQL first: ../../supabase/README.md

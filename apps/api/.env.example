# Copy to .env for local development. Never commit real secrets.
PORT=8787
NODE_ENV=development

# Long random string. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-for-local-dev-only

# Comma-separated origins allowed to call the API (mobile / Expo).
# Leave empty in development to allow Expo LAN / localhost.
CORS_ORIGINS=

# Access token lifetime in seconds (default 1 hour). Keep short.
JWT_TTL_SECONDS=3600

# SQLite file for accounts + homes + document metadata (created automatically).
# Use :memory: only for automated tests.
DATABASE_PATH=./data/homeasset.sqlite

# Durable file store for uploaded manuals / photos (alongside the DB).
STORAGE_PATH=./data/files

# Optional max upload size in bytes (default 15 MiB).
# MAX_UPLOAD_BYTES=15728640

# Shared secret for POST /jobs/due-reminders (cron). Required in production.
# Leave empty in local development to allow unauthenticated due-check.
# JOBS_SECRET=

# Optional Expo access token for live push delivery.
# Without it, pushes are stubbed (logged) and the in-app center still works.
# EXPO_ACCESS_TOKEN=

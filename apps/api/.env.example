# Copy to .env for local development. Never commit real secrets.
PORT=8787
NODE_ENV=development

# Long random string. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-for-local-dev-only

# Comma-separated origins allowed to call the API (mobile / Expo).
# Leave empty in development to allow Expo LAN / localhost.
CORS_ORIGINS=

# Access token lifetime in seconds (default 1 hour). Keep short.
JWT_TTL_SECONDS=3600
